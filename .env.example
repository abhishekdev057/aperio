# Copy to .env.local and fill in. Never commit .env.local.

# Neon PostgreSQL connection string
DATABASE_URL=

# Server-side Gemini API key (never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
# Optional: comma-separated model fallback order (default: gemini-2.5-flash,gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 "Web application" client (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the deployed app, no trailing slash. Used to build the OAuth
# redirect URI so it matches the one registered in Google Cloud Console.
# Local dev can leave this unset (falls back to the request origin).
APP_ORIGIN=https://aperio-umber.vercel.app
